{
    "name": "andriichuk/laravel-billing",
    "description": "Vendor-agnostic subscription billing primitives for Laravel.",
    "keywords": ["billing", "laravel", "payments", "subscriptions"],
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Serhii Andriichuk", "email": "andriichuk29@gmail.com"}],
    "support": {
        "issues": "https://github.com/andriichuk/laravel-billing/issues",
        "source": "https://github.com/andriichuk/laravel-billing"
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "illuminate/bus": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {"psr-4": {"Andriichuk\\LaravelBilling\\": "src/"}},
    "autoload-dev": {"psr-4": {"Andriichuk\\LaravelBilling\\Tests\\": "tests/"}},
    "extra": {
        "branch-alias": {"dev-main": "0.2.x-dev"},
        "laravel": {"providers": ["Andriichuk\\LaravelBilling\\BillingServiceProvider"]}
    },
    "scripts": {
        "format": "pint",
        "format:test": "pint --test",
        "test": "phpunit",
        "analyse": "phpstan analyse --debug --no-progress --memory-limit=1G",
        "check": ["@format:test", "@test", "@analyse"]
    },
    "config": {"allow-plugins": {}, "sort-packages": true},
    "minimum-stability": "dev",
    "prefer-stable": true
}
